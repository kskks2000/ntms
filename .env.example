# =====================================================================
# NTMS 환경변수 예시
#   cp .env.example .env  후 실제 값으로 채운다.
#   .env 는 .gitignore 대상이다. 절대 커밋하지 말 것.
#
#   시크릿 생성:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =====================================================================

# --- 공통 -------------------------------------------------------------
NODE_ENV=development
TZ=Asia/Seoul

# 외부 접속 주소 (서버 배포 시 실제 도메인 또는 http://<서버IP>)
PUBLIC_ORIGIN=http://localhost:3000

# --- 데이터베이스 -----------------------------------------------------
# Docker 컨테이너 초기화용 (서버 배포 시에만 사용)
POSTGRES_DB=ntms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=변경하세요

# ---------------------------------------------------------------------
# 애플리케이션 접속은 반드시 ntms_app 역할로 한다.
#
# postgres(슈퍼유저)로 접속하면 RLS 가 통째로 무시된다.
# 슈퍼유저는 FORCE ROW LEVEL SECURITY 조차 우회하므로,
# 테넌트 격리가 조용히 사라지고 모든 테넌트의 데이터가 한 화면에 섞인다.
# 에러도 경고도 없이 동작하기 때문에 운영에서 발견하기 가장 어려운 종류의 사고다.
#
# ntms_app 은 DDL 이 NOLOGIN 으로 만들어두었다. 아래로 로그인을 부여한다.
#   ALTER ROLE ntms_app WITH LOGIN PASSWORD '<앱 전용 비밀번호>';
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://ntms_app:앱전용비밀번호@localhost:5432/ntms?schema=ntms

# 서버(Docker): 호스트명이 postgres 로 바뀐다
# DATABASE_URL=postgresql://ntms_app:앱전용비밀번호@postgres:5432/ntms?schema=ntms&connection_limit=20

# DDL 적용 / 마이그레이션 전용 (RLS 우회 필요). 애플리케이션은 절대 이 값을 쓰지 않는다.
# ALTER ROLE ntms_admin WITH LOGIN PASSWORD '<관리 전용 비밀번호>';
ADMIN_DATABASE_URL=postgresql://ntms_admin:관리자비밀번호@localhost:5432/ntms?schema=ntms

# --- Redis ------------------------------------------------------------
REDIS_PASSWORD=변경하세요
REDIS_URL=redis://:변경하세요@localhost:6379

# --- 인증 -------------------------------------------------------------
JWT_ACCESS_SECRET=변경하세요_48바이트_랜덤
JWT_REFRESH_SECRET=변경하세요_48바이트_랜덤_다른값
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 로그인 정책
LOGIN_MAX_FAIL_COUNT=5
PASSWORD_EXPIRE_DAYS=90
DORMANT_DAYS=365

# --- API --------------------------------------------------------------
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Web --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
INTERNAL_API_URL=http://localhost:4000

# --- 외부 연계 (미정 — 확정 후 채운다) ---------------------------------
# SMS_API_KEY=
# KAKAO_ALIMTALK_KEY=
# MAP_API_KEY=
# NTS_INVOICE_API_KEY=
