# =====================================================================
# NTMS 환경변수 예시
#   cp .env.example .env  후 실제 값으로 채운다.
#   .env 는 .gitignore 대상이다. 절대 커밋하지 말 것.
#
#   시크릿 생성:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =====================================================================

# --- 공통 -------------------------------------------------------------
NODE_ENV=development
TZ=Asia/Seoul

# 외부 접속 주소 (서버 배포 시 실제 도메인 또는 http://<서버IP>)
PUBLIC_ORIGIN=http://localhost:3000

# --- 데이터베이스 -----------------------------------------------------
POSTGRES_DB=ntms
POSTGRES_USER=ntms_owner
POSTGRES_PASSWORD=변경하세요

# 로컬 개발: 네이티브 설치된 PostgreSQL 18
DATABASE_URL=postgresql://ntms_owner:변경하세요@localhost:5432/ntms?schema=ntms

# 서버(Docker): 호스트명이 postgres 로 바뀐다 — docker-compose.yml 이 자동 주입
# DATABASE_URL=postgresql://ntms_owner:변경하세요@postgres:5432/ntms?schema=ntms&connection_limit=20

# 애플리케이션 접속 역할 (RLS 적용). 마이그레이션은 ntms_admin 을 쓴다.
DATABASE_APP_ROLE=ntms_app

# --- Redis ------------------------------------------------------------
REDIS_PASSWORD=변경하세요
REDIS_URL=redis://:변경하세요@localhost:6379

# --- 인증 -------------------------------------------------------------
JWT_ACCESS_SECRET=변경하세요_48바이트_랜덤
JWT_REFRESH_SECRET=변경하세요_48바이트_랜덤_다른값
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 로그인 정책
LOGIN_MAX_FAIL_COUNT=5
PASSWORD_EXPIRE_DAYS=90
DORMANT_DAYS=365

# --- API --------------------------------------------------------------
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Web --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
INTERNAL_API_URL=http://localhost:4000

# --- 외부 연계 (미정 — 확정 후 채운다) ---------------------------------
# SMS_API_KEY=
# KAKAO_ALIMTALK_KEY=
# MAP_API_KEY=
# NTS_INVOICE_API_KEY=
