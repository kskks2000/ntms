model actual_order {
  actual_order_id      BigInt              @id @default(autoincrement())
  tenant_id            BigInt
  actual_id            BigInt
  order_id             BigInt
  shipper_id           BigInt
  delivered_qty        Decimal             @default(0) @db.Decimal(14, 3)
  delivered_weight_kg  Decimal             @default(0) @db.Decimal(14, 3)
  delivered_volume_cbm Decimal             @default(0) @db.Decimal(14, 4)
  delivered_pallet_qty Decimal?            @db.Decimal(10, 2)
  damaged_qty          Decimal             @default(0) @db.Decimal(14, 3)
  shortage_qty         Decimal             @default(0) @db.Decimal(14, 3)
  returned_qty         Decimal             @default(0) @db.Decimal(14, 3)
  delivery_result      pod_result          @default(NORMAL)
  delivered_at         DateTime?           @db.Timestamptz(6)
  distance_km          Decimal?            @db.Decimal(12, 3)
  allocation_basis     String?             @db.VarChar(20)
  allocation_ratio     Decimal?            @db.Decimal(9, 4)
  billing_amount       Decimal?            @db.Decimal(18, 2)
  payment_amount       Decimal?            @db.Decimal(18, 2)
  on_time_delivery     Boolean?
  pod_id               BigInt?
  remark               String?             @db.VarChar(500)
  created_at           DateTime            @default(now()) @db.Timestamptz(6)
  created_by           BigInt?
  updated_at           DateTime            @default(now()) @db.Timestamptz(6)
  updated_by           BigInt?
  row_version          Int                 @default(0)
  transport_actual     transport_actual    @relation(fields: [actual_id], references: [actual_id], onDelete: Cascade, onUpdate: NoAction)
  transport_order      transport_order     @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
  pod                  pod?                @relation(fields: [pod_id], references: [pod_id], onDelete: NoAction, onUpdate: NoAction)
  business_partner     business_partner    @relation(fields: [shipper_id], references: [partner_id], onDelete: NoAction, onUpdate: NoAction)
  tenant               tenant              @relation(fields: [tenant_id], references: [tenant_id], onDelete: NoAction, onUpdate: NoAction)
  settlement_detail    settlement_detail[]

  @@unique([actual_id, order_id], map: "uk_actual_order")
  @@index([tenant_id, order_id], map: "ix_actual_order_order")
  @@index([tenant_id, shipper_id, delivered_at(sort: Desc)], map: "ix_actual_order_shipper")
}

